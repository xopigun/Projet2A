[submodule "firmware/vendor/cmsis_core"]
	path = firmware/vendor/cmsis_core
	url = https://github.com/STMicroelectronics/cmsis_core.git
[submodule "firmware/vendor/cmsis_device_g4"]
	path = firmware/vendor/cmsis_device_g4
	url = https://github.com/STMicroelectronics/cmsis_device_g4.git
[submodule "firmware/vendor/stm32g4xx_hal_driver"]
	path = firmware/vendor/stm32g4xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32g4xx_hal_driver.git
[submodule "firmware/vendor/cmsis_device_f1"]
	path = firmware/vendor/cmsis_device_f1
	url = https://github.com/STMicroelectronics/cmsis_device_f1.git
[submodule "firmware/vendor/stm32f1xx_hal_driver"]
	path = firmware/vendor/stm32f1xx_hal_driver
