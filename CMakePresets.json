{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "arm",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-none-eabi.cmake"
    },
    {
      "name": "host",
      "inherits": "base",
      "displayName": "Tests hote (natif)",
      "description": "Compile et execute les tests unitaires du code commun, sans HAL.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BENCH_NODE_ID": "0"
      }
    },
    {
      "name": "n1",
      "inherits": "arm",
      "displayName": "N1 - commande energie (Nucleo-G431KB)",
      "cacheVariables": {
        "BENCH_NODE_ID": "1"
      }
    },
    {
      "name": "n2",
      "inherits": "arm",
      "displayName": "N2 - IMU + vitesse (Nucleo-G431KB)",
      "cacheVariables": {
        "BENCH_NODE_ID": "2"
      }
    },
    {
      "name": "n3",
      "inherits": "arm",
      "displayName": "N3 - temperature + batterie (Nucleo-G431KB)",
      "cacheVariables": {
        "BENCH_NODE_ID": "3"
      }
    },
    {
      "name": "n4",
      "inherits": "arm",
      "displayName": "N4 - noeud fautif (Blue Pill STM32F103)",
      "cacheVariables": {
        "BENCH_NODE_ID": "4"
      }
    },
    {
      "name": "n1-selftest",
      "inherits": "n1",
      "displayName": "N1 - autotest de mise en route",
      "description": "Bouclage interne FDCAN puis ping/pong ; sortie sur le VCP.",
      "binaryDir": "${sourceDir}/build/n1-selftest",
      "cacheVariables": {
        "BENCH_SELFTEST": "ON"
      }
    },
    {
      "name": "n2-selftest",
      "inherits": "n2",
      "displayName": "N2 - autotest de mise en route",
      "description": "Bouclage interne FDCAN puis ping/pong ; sortie sur le VCP.",
      "binaryDir": "${sourceDir}/build/n2-selftest",
      "cacheVariables": {
        "BENCH_SELFTEST": "ON"
      }
    },
    {
      "name": "n3-selftest",
      "inherits": "n3",
      "displayName": "N3 - autotest de mise en route",
      "description": "Bouclage interne FDCAN puis ping/pong ; sortie sur le VCP.",
      "binaryDir": "${sourceDir}/build/n3-selftest",
      "cacheVariables": {
        "BENCH_SELFTEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "n1",
      "configurePreset": "n1"
    },
    {
      "name": "n2",
      "configurePreset": "n2"
    },
    {
      "name": "n3",
      "configurePreset": "n3"
    },
    {
      "name": "n4",
      "configurePreset": "n4"
    },
    {
      "name": "n1-selftest",
      "configurePreset": "n1-selftest"
    },
    {
      "name": "n2-selftest",
      "configurePreset": "n2-selftest"
    },
    {
      "name": "n3-selftest",
      "configurePreset": "n3-selftest"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ]
}
