s (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "3f8464de-226f-5460-919b-6da96935f74a")) (instances (project "cablage_bus_can" (path "/3b7d2c10-8e4f-4a55-9c21-6a0f5e7b9d42" (reference "#FLG06") (unit 1))))) (wire (pts (xy 104.14 198.12) (xy 187.96 198.12)) (stroke (width 0) (type default)) (uuid "7f10dd8e-2eb9-5d81-a9bb-8ab00152aa0b")) (wire (pts (xy 187.96 198.12) (xy 271.78 198.12)) (stroke (width 0) (type default)) (uuid "1119b8b1-6ac3-5620-940f-db37dc83e0e7")) (wire (pts (xy 271.78 198.12) (xy 330.2 198.12)) (stroke (width 0) (type default)) (uuid "db421ef6-181a-52f8-9403-2b00cb353d0c")) (wire (pts (xy 330.2 198.12) (xy 335.28 198.12)) (stroke (width 0) (type default)) (uuid "d993be08-5ab5-50fc-b339-fc5bf61f3a14")) (wire (pts (xy 335.28 198.12) (xy 337.82 198.12)) (stroke (width 0) (type default)) (uuid "f9651860-38ea-5cee-b491-a3851b625a14")) (text "G69 - CABLAGE DU BUS CAN : 3 NUCLEO-G431KB + ADAFRUIT CAN PAL, USBCAN-Z, ALIMENTATION" (exclude_from_sim no) (at 20.32 22.86 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left bottom)) (uuid "153f2e9e-bb09-5f9d-a478-23a069ad6440")) (text "Bus réel à 500 kbit/s : paire torsadée CAN_H / CAN_L + masse commune. Ordre physique sur la ligne : USBCAN-Z - N1 - N2 - N3." (exclude_from_sim no) (at 20.32 27.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "fb15ec65-19f6-5007-95a6-4473e6b7e57d")) (text "Dérivation de chaque nœud vers la ligne : la plus courte possible (≤ 0,3 m). Terminaisons aux deux extrémités seulement." (exclude_from_sim no) (at 20.32 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "981e9206-93ec-52d1-b11e-40368908260e")) (text "AVANT LA PREMIÈRE MISE SOUS TENSION" (exclude_from_sim no) (at 320.04 45.72 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "00745b49-53ca-5bf3-b820-62ef88db61f5")) (text "1. Sur chaque Nucleo, retirer le cavalier HW1 (CN4-4 / CN4-5) :" (exclude_from_sim no) (at 320.04 49.53 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "922572b2-09d0-5956-8289-1dea5c57e874")) (text "   PA12 = FDCAN1_TX, laissé à la masse il bloque le bus en dominant." (exclude_from_sim no) (at 320.04 53.34 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "87174123-d3f1-5735-835b-ad92e5c8b7e4")) (text "2. Programmer les presets normaux n1, n2, n3 (TX push-pull)." (exclude_from_sim no) (at 320.04 57.15 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f91c4bba-0d4d-5bac-9d43-28e85fdf0796")) (text "   JAMAIS les presets *-direct quand un transceiver est câblé." (exclude_from_sim no) (at 320.04 60.96 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b2def210-0abd-5a8d-86dc-5181673431ae")) (text "3. Ponts SB9/SB10 non soudés : compiler en HSI, aucun verdict." (exclude_from_sim no) (at 320.04 64.77 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "869e94ca-a344-5889-9847-1232a0c7b40f")) (text "4. Hors tension, entre CAN_H et CAN_L : mesurer environ 60 Ω." (exclude_from_sim no) (at 320.04 68.58 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "417e2e3c-ea6e-57f9-93c8-bc3dc305f1cc")) (text "   120 Ω : une terminaison manque ; < 40 Ω : une de trop." (exclude_from_sim no) (at 320.04 72.39 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ed69f130-fe50-5857-a623-8fb3feacf546")) (text "TERMINAISONS (interrupteurs)" (exclude_from_sim no) (at 320.04 80.01 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "d785dd9a-f847-5e9a-9d0f-35e599871917")) (text "USBCAN-Z : ON. CAN Pal de N3 : ON. CAN Pal de N1 et N2 : OFF." (exclude_from_sim no) (at 320.04 83.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "92ea5edb-2d50-5cf9-826a-0736145a55da")) (text "ALIMENTATION FI 1233" (exclude_from_sim no) (at 320.04 91.44 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "1712c806-cb38-5878-ac15-a125bccbe6ed")) (text "Voie CH1 seule, mode INDEP. Régler 8,0 V et limiter à 1 A," (exclude_from_sim no) (at 320.04 95.25 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b98b3c83-7206-50d3-9fd7-6f660bacc338")) (text "sortie coupée (OUTPUT OFF) pendant le câblage." (exclude_from_sim no) (at 320.04 99.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a0599819-1b27-522c-8b51-b03c7c8654a0")) (text "VIN = CN3-1 (7 à 12 V ; 450 mA par carte entre 7 et 9 V)." (exclude_from_sim no) (at 320.04 102.87 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7a683205-ac5c-59be-8848-f187dfb54670")) (text "Ne pas relier la borne verte GND (terre) : CH1- = masse du banc." (exclude_from_sim no) (at 320.04 106.68 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c1949be9-f7a6-5a22-9f43-35b89b27f5e9")) (text "Ordre (UM2397 §6.4.1) : OUTPUT ON, vérifier LD4 verte allumée" (exclude_from_sim no) (at 320.04 110.49 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c37cc425-44b3-5dc0-b393-62e803c32101")) (text "sur chaque Nucleo, PUIS brancher les câbles USB." (exclude_from_sim no) (at 320.04 114.3 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7ceefc52-e2bd-5652-9676-60f5bfc2e821")) (text "Sans l'alimentation : chaque Nucleo sur son USB, VIN non câblé." (exclude_from_sim no) (at 320.04 118.11 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "85f28329-7595-5e4b-a5c4-fd755cfc6243")) (text "CAN PAL (Adafruit 5708)" (exclude_from_sim no) (at 320.04 125.73 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "10391cd7-3654-5a14-bac6-ddc43fd39180")) (text "Vcc sur le 3V3 de la Nucleo : la pompe de charge de la carte" (exclude_from_sim no) (at 320.04 129.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "40146701-25e0-5510-aa35-424a54302fa9")) (text "fabrique le 5 V du TJA1051T/3. SLNT à GND = mode normal." (exclude_from_sim no) (at 320.04 133.35 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2afcad7f-434c-5e43-84d0-2b5ec514266f")) (text "CANH/CANL de la barrette = bornier L/H : on câble le bornier." (exclude_from_sim no) (at 320.04 137.16 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4680de3c-1552-5770-9c67-83901239aedd")) (text "USBCAN-Z" (exclude_from_sim no) (at 320.04 144.78 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left bottom)) (uuid "375dab03-636e-58d0-a23c-2cc84ac2cd74")) (text "Clone ZLG USBCAN-I (USB 0471:1200), pilote propriétaire ZLG :" (exclude_from_sim no) (at 320.04 148.59 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "55f28c29-ea94-5cee-93ca-daa24121d25b")) (text "ZCANPRO ou pc/moniteur_dialogue.py. Ni slcan ni gs_usb." (exclude_from_sim no) (at 320.04 152.4 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1b142281-8f33-5cb1-b7ef-c9f05689352a")) (text "Sources : UM2397 Rev 2 §6.4, Tables 5 et 11 ; learn.adafruit.com/adafruit-can-pal ; docs/pinout.md §1, §5, §6." (exclude_from_sim no) (at 20.32 260.35 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0bc7cb41-7b13-56fb-8f1a-c903cd61278a")) (junction (at 66.04 60.96) (diameter 0) (color 0 0 0 0) (uuid "eee371d8-ad17-5dd4-8255-727537ffa871")) (junction (at 109.22 53.34) (diameter 0) (color 0 0 0 0) (uuid "bbce2035-e150-5985-a231-443dc0e874c8")) (junction (at 114.3 60.96) (diameter 0) (color 0 0 0 0) (uuid "696e41a5-81e0-5a76-b9cc-53cff6a046c1")) (junction (at 119.38 45.72) (diameter 0) (color 0 0 0 0) (uuid "80320328-4408-55a2-ab7d-83e8ebd58759")) (junction (at 182.88 190.5) (diameter 0) (color 0 0 0 0) (uuid "46e9221b-b759-5d03-b4df-2293e4ce1257")) (junction (at 187.96 198.12) (diameter 0) (color 0 0 0 0) (uuid "377ce434-843b-56af-8e7e-97cd6dda1abd")) (junction (at 193.04 53.34) (diameter 0) (color 0 0 0 0) (uuid "bc40300f-28cb-5e09-8ad6-c186042faf55")) (junction (at 198.12 60.96) (diameter 0) (color 0 0 0 0) (uuid "589bb6f4-8b3b-56d9-a44f-70318a713ea9")) (junction (at 203.2 45.72) (d